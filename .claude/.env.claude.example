# Claude Code Project Profile Template
# Generated by session_start.sh - Copy to .env.claude and customize if needed
#
# AUTO-DETECTED values are computed at session start.
# Override any value by setting it before running Claude Code.
#
# Usage:
#   - Most values are auto-detected; no manual config needed
#   - Override specific values in your shell before starting Claude Code:
#     export COMPOSE_FILE=custom/compose.yml
#     claude
#
# Note: .env.claude is gitignored by default. If you want project-specific
# overrides committed, create .env.claude.local and source it.

# ============================================================================
# PROJECT IDENTIFICATION (auto-detected)
# ============================================================================

# Project root directory (absolute path)
# AUTO: $(git rev-parse --show-toplevel || pwd)
CLAUDE_PROJECT_ROOT=

# Project name, sanitized for compose (lowercase, alphanumeric, dashes)
# AUTO: basename of CLAUDE_PROJECT_ROOT, sanitized
COMPOSE_PROJECT_NAME=

# ============================================================================
# DOCKER COMPOSE (auto-detected if compose file exists)
# ============================================================================

# Path to compose file, relative to project root
# AUTO: First found of: docker-compose.yml, compose.yml, compose.yaml,
#       infra/docker-compose.yml, infra/compose.yml, .docker/docker-compose.yml
# Leave empty if no compose file (repo-only mode)
COMPOSE_FILE=

# Path to dev overlay compose file (optional)
# AUTO: ${COMPOSE_FILE%.yml}.dev.yml or ${COMPOSE_FILE%.yaml}.dev.yaml if exists
COMPOSE_DEV_FILE=

# Service names - auto-detected from compose services or leave empty
# These are heuristics; override if your project uses different names
API_SERVICE=
WEB_SERVICE=

# ============================================================================
# PREFLIGHT CONFIGURATION
# ============================================================================

# Services to check in preflight (space-separated)
# AUTO: empty (no preflight) if COMPOSE_FILE is empty
# Override to specify exact services: "backend redis mongodb"
PREFLIGHT_SERVICES=

# Throttle interval in seconds (avoid running preflight repeatedly)
PREFLIGHT_THROTTLE_SECONDS=15

# ============================================================================
# AGENT CONFIGURATION
# ============================================================================

# Root directory for agent outputs and artifacts
AGENT_OUTPUT_ROOT=.claude/docs

# Root directory for kanban tasks
KANBAN_ROOT=docs/kanban

# ============================================================================
# TOOLS
# ============================================================================

# Search tool (auto-detected: rg preferred, fallback to grep)
SEARCH_TOOL=

# ============================================================================
# SESSION INFO (set at runtime, not for override)
# ============================================================================

# Session start timestamp
SESSION_START=

# Last preflight run timestamp (managed by preflight.sh)
# Stored in .claude/.preflight_last_run, not here
