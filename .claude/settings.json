{
  "env": {
    "CLAUDE_ENV_FILE": ".claude/.env.claude",
    "ENABLE_TOOL_SEARCH": "auto:5"
  },
  "permissions": {
    "allow": [
      "Bash(make:*)",
      "Bash(docker compose:*)",
      "Bash(docker ps:*)",
      "Bash(docker inspect:*)",
      "Bash(docker logs:*)",
      "Bash(docker system df)",
      "Bash(df -h)",
      "Bash(free -m)",
      "Bash(pnpm:*)",
      "Bash(bun:*)",
      "Bash(npm:*)",
      "Bash(pytest:*)",
      "Bash(python -m pytest:*)",
      "Bash(./.claude/skills/**/scripts/*.sh)",
      "Bash(./.claude/hooks/*.sh)",
      "Bash(rg:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(tree:*)",
      "Bash(ls:*)",
      "Bash(wc:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(cut:*)",
      "Bash(echo:*)",
      "Bash(pwd)",
      "Bash(which:*)",
      "Bash(env)",
      "Bash(date:*)",
      "Bash(sleep:*)",
      "Bash(timeout:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git rev-parse:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git remote:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git stash:*)",
      "Bash(curl:*)",
      "Bash(ssh:*)",
      "Bash(docker build:*)",
      "Bash(docker push:*)",
      "Bash(docker tag:*)",
      "Bash(docker exec:*)",
      "Bash(docker images:*)",
      "Bash(docker manifest:*)",
      "Bash(rm -f .claude/agents/debug-*.md)",
      "Bash(rm -f .claude/agents/builder-*.md)",
      "Bash(rm:docs/agent/*.txt)",
      "Bash(rm -f:docs/agent/*.md)",
      "Bash(rm:docs/agent/*.md)",
      "Bash(mkdir -p:*)",
      "Bash(cp:*)",
      "Bash(rm -f tests/unit/services/*)",
      "Bash(rm -rf tests/unit/services)",
      "Bash(touch:*)",
      "Bash(rmdir *)",
      "Bash(rm -r *_debug)",
      "Bash(rm -rf *_debug)",
      "Bash(rm -r *debug)",
      "Bash(rm -rf *debug)",
      "Bash(rm -r *debug/)",
      "Bash(rm -rf *debug/)",
      "Bash(rm -rf happy_path_debug)",
      "Bash(rm *_results.json)",
      "Bash(source envs/.env)",
      "Bash(source ~/.bashrc)",
      "Bash(source .venv/bin/activate)",
      "Bash(. envs/.env)",
      "Bash(. ~/.bashrc)",
      "Bash(. .venv/bin/activate)",
      "Bash(python -m bankadvisor.etl_loader)",
      "Bash(docker exec * python -m bankadvisor.etl_loader)",
      "Bash(docker rmi:*)",
      "Read(src/**)",
      "Read(apps/**)",
      "Read(plugins/**)",
      "Read(docs/**)",
      "Read(infra/**)",
      "Read(.claude/**)",
      "Read(tests/**)",
      "Read(*.md)",
      "Read(*.json)",
      "Read(*.yaml)",
      "Read(*.yml)",
      "Read(*.toml)",
      "Read(*.txt)",
      "Read(Makefile)",
      "Read(package.json)",
      "Read(pyproject.toml)",
      "Read(envs/.env)",
      "Read(envs/.env.*)",
      "Write(src/**)",
      "Write(apps/**)",
      "Write(plugins/**)",
      "Write(docs/**)",
      "Write(infra/**)",
      "Write(.claude/**)",
      "Write(tests/**)",
      "Edit(src/**)",
      "Edit(apps/**)",
      "Edit(plugins/**)",
      "Edit(docs/**)",
      "Edit(infra/**)",
      "Edit(.claude/**)",
      "Edit(tests/**)"
    ],
    "deny": [
      "Read(**/secrets/**)",
      "Read(**/credentials*)",
      "Read(**/*private*key*)",
      "Read(**/*secret*)",
      "Read(.claude/.env.claude)",
      "Read(.aws/**)",
      "Read(.ssh/**)",
      "Read(.gnupg/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Write(**/secrets/**)",
      "Write(**/credentials*)",
      "Write(**/*private*key*)",
      "Write(**/*secret*)",
      "Write(.aws/**)",
      "Write(.ssh/**)",
      "Write(.gnupg/**)",
      "Write(**/*.pem)",
      "Write(**/*.key)",
      "Edit(**/secrets/**)",
      "Edit(**/credentials*)",
      "Edit(**/*private*key*)",
      "Edit(**/*secret*)",
      "Edit(.aws/**)",
      "Edit(.ssh/**)",
      "Edit(.gnupg/**)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)",
      "Bash(rm -rf src)",
      "Bash(rm -rf apps)",
      "Bash(rm -rf plugins)",
      "Bash(rm -rf infra)",
      "Bash(rm -rf .claude)",
      "Bash(rm -rf .git)",
      "Bash(rm -rf node_modules)",
      "Bash(rm -r src)",
      "Bash(rm -r apps)",
      "Bash(rm -r plugins)",
      "Bash(rm -r infra)",
      "Bash(rm -r .claude)",
      "Bash(rm -r .git)",
      "Bash(rm -f **/src/**)",
      "Bash(rm -f **/apps/**)",
      "Bash(rm -f **/plugins/**)",
      "Bash(rm -f **/infra/**)",
      "Bash(rm -f **/tests/**)",
      "Bash(rm -f **/package*.json)",
      "Bash(rm -f **/pyproject.toml)",
      "Bash(rm -f **/Makefile)",
      "Bash(rm -f **/*.sh)",
      "Bash(git reset --hard:*)",
      "Bash(git checkout -- .)",
      "Bash(git clean:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git rebase:*)",
      "Bash(wget:*)",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Bash(tee:*)",
      "Bash(dd:*)",
      "Bash(mkfs:*)",
      "Bash(mount:*)",
      "Bash(umount:*)",
      "Bash(chmod 777:*)",
      "Bash(chown:*)",
      "Bash(sudo:*)",
      "Bash(su:*)",
      "Bash(eval:*)",
      "Bash(exec:*)",
      "Bash(kill:*)",
      "Bash(pkill:*)",
      "Bash(killall:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/session_start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash(git push*)",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/pre_push_checks.sh"
          }
        ]
      },
      {
        "matcher": "Bash(gh pr create*)",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/pre_push_checks.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "figma@claude-plugins-official": true
  }
}
