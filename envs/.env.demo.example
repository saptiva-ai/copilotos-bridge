# =============================================================================
# Environment Template: DEMO tenant
# =============================================================================
# Copy to .env and fill in secrets for demo deployment.
# These variables override base .env values for the demo tenant.

# -- CORS & Allowed Hosts --
CORS_ORIGINS=["https://demo.saptiva.com","https://back-demo.saptiva.com"]
ALLOWED_HOSTS=["demo.saptiva.com","back-demo.saptiva.com"]

# -- Public URLs --
PASSWORD_RESET_URL_BASE=https://demo.saptiva.com
MAIL_FROM_NAME=OctaviOS Support
