# Copy to .env and fill in secrets for INVEX deployment.
# These variables override base .env values for the INVEX tenant.

# -- CORS & Allowed Hosts --
CORS_ORIGINS=["https://invex.saptiva.com","https://back-invex.saptiva.com"]
ALLOWED_HOSTS=["invex.saptiva.com","back-invex.saptiva.com"]

# -- Public URLs --
PASSWORD_RESET_URL_BASE=https://invex.saptiva.com
MAIL_FROM_NAME=INVEX OctaviOS
