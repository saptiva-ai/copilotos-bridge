{
  "name": "web",
  "version": "1.4.42",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "dev:bun": "bunx next dev --hostname 0.0.0.0",
    "build": "next build",
    "build:bun": "bunx next build",
    "start": "next start",
    "start:bun": "bunx next start -H 0.0.0.0 -p 3000",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:bun": "bunx jest",
    "test:e2e": "playwright test",
    "test:e2e:pdf": "bash ./scripts/run-e2e-with-pdf-report.sh",
    "test:e2e:pdf:strict": "E2E_PDF_STRICT=1 bash ./scripts/run-e2e-with-pdf-report.sh",
    "test:e2e:fast": "E2E_SKIP_PDF=1 bash ./scripts/run-e2e-with-pdf-report.sh",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:e2e:pdf:generate": "node ./scripts/generate-e2e-pdf-report.mjs",
    "test:e2e:install": "playwright install chromium firefox",
    "test:watch": "jest --watch",
    "clean": "rm -rf .next dist node_modules",
    "prepare": "cd ../.. && husky apps/web/.husky"
  },
  "dependencies": {
    "@copilotos/shared": "workspace:*",
    "@headlessui/react": "^2",
    "@heroicons/react": "^2.2.0",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-query": "^5.90.11",
    "@tanstack/react-query-devtools": "^5.91.1",
    "@types/dompurify": "^3.2.0",
    "axios": "^1.13.5",
    "clsx": "^2.1.1",
    "dompurify": "^3.3.0",
    "framer-motion": "^12.23.25",
    "katex": "^0.16.25",
    "next": "^15.5.12",
    "next-themes": "^0.4.6",
    "plotly.js": "^3.3.0",
    "plotly.js-dist-min": "^3.3.0",
    "react": "^19",
    "react-dom": "^19",
    "react-hot-toast": "^2.6.0",
    "react-markdown": "^10.1.0",
    "react-plotly.js": "^2.6.0",
    "react-syntax-highlighter": "^16.1.0",
    "react-window": "^2.2.3",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remend": "^1.1.0",
    "sharp": "^0.33.0",
    "tailwind-merge": "^2.6.0",
    "unified": "^11.0.5",
    "uuid": "^13.0.0",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@playwright/test": "^1.50.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.25",
    "@types/plotly.js": "^3.0.8",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-plotly.js": "^2.6.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/react-window": "^2.0.0",
    "@typescript-eslint/eslint-plugin": "^8.48.1",
    "@typescript-eslint/parser": "^8.48.1",
    "autoprefixer": "^10.4.22",
    "eslint": "^9.26.0",
    "eslint-config-next": "^15",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^15.5.2",
    "postcss": "^8.5.6",
    "prettier": "^3.7.4",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "bash ./scripts/lint-staged-eslint-fix.sh",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
