    bank_dim_estado ||--o{ bank_fact_cartera_vivienda : "estado_id"

    bank_dim_institucion ||--o{ bank_fact_kpis_mensual : "institucion_id"
    bank_dim_periodo ||--o{ bank_fact_kpis_mensual : "periodo_id"

    bank_dim_institucion ||--o{ bank_fact_metricas_financieras : "institucion_id"
    bank_dim_periodo ||--o{ bank_fact_metricas_financieras : "periodo_id"

    bank_dim_institucion ||--o{ bank_fact_cartera_segmentada : "institucion_id"
