    bank_dim_destino_credito ||--o{ bank_fact_cartera_comercial : "destino_id"
    bank_dim_apoyo ||--o{ bank_fact_cartera_comercial : "apoyo_id"
    bank_dim_estado ||--o{ bank_fact_cartera_comercial : "estado_id"

    bank_dim_institucion ||--o{ bank_fact_cartera_comercial_marginal : "institucion_id"
